    {
      "id": "related-data-content",
      "title": {
        "ja": "糖鎖関連遺伝子",
        "en": "Glycan-Related Genes"
      },
      "titleTooltip": {
        "ja": "",
        "en": ""
      },
      "description": {
        "ja": "NanbyoDataに収載されている国際リソース由来の疾患関連遺伝子のうち、糖鎖に関連する遺伝子を表示しています。糖鎖に関連する遺伝子は、糖鎖科学ポータルサイトGlyCosmosで提供されている GlyCosmos Genes を利用しています。\n\n本ページでは、NanbyoDataの疾患と国際疾患語彙集（オントロジー）である Mondo Disease Ontology（Mondo）との対応付け情報をもとに、疾患関連遺伝子を掲載しています。NANDO と Mondo の exactMatch（同一概念）および closeMatch（近似概念）の両方を含む対応付けを利用しています。\n\n本ページでは、「糖鎖遺伝子」および「NanbyoData疾患」のそれぞれを軸としたリストを、タブ切り替えで閲覧できます。タブに表示される数値は、糖鎖遺伝子数およびNanbyoData疾患数を示します。また、右側の Download 機能から、NanbyoDataに収載されている糖鎖関連データを取得できます。",
        "en": "This page displays glycan-related genes associated with diseases in NanbyoData. These genes are based on GlyCosmos Genes provided by the glycoscience portal GlyCosmos.\n\nDisease-associated genes are integrated using mappings between diseases in NanbyoData and the Mondo Disease Ontology (Mondo), an international disease vocabulary and ontology. The displayed data include both exactMatch relationships (equivalent disease concepts) and closeMatch relationships (closely related disease concepts) between NANDO and Mondo.\n\nThe data can be explored through two tab-based views: one centered on glycan-related genes and the other centered on NanbyoData diseases. The numbers displayed on the tabs indicate the total numbers of glycan-related genes and NanbyoData diseases, respectively.\n\nRelated glycan datasets included in NanbyoData can also be downloaded using the Download function on the right side of the page."
      },
      "hasTabs": true,
      "tabs": [
        {
          "id": "by-gene",
          "countDataKey": "genesymbol",
          "label": {
            "ja": "糖鎖遺伝子",
            "en": "Glycan-related Genes"
          },
          "tooltip": {
            "ja": "糖鎖に関連する遺伝子ごとに、関連するNanbyoData疾患をまとめたリスト",
            "en": "List of NanbyoData diseases associated with each glycan-related genes"
          },
          "dataUrl": "/download/latest/nando-glycogene.json",
          "columns": [
            {
              "dataKey": "genesymbol",
              "label": {
                "ja": "Gene Symbol (GlyCosmos Genes)",
                "en": "Gene Symbol (GlyCosmos Genes)"
              },
              "tooltip": {
                "ja": "GlyCosmos Genesより提供されている遺伝子",
                "en": "Genes provided by GlyCosmos Genes"
              },
              "link": "external",
              "linkHrefKey": "glycogene",
              "linkTextKey": "genesymbol",
              "rowspan": true,
              "rowspanVerticalAlign": "top"
            },
            {
              "dataKeyByLocale": {
                "ja": "nando_label",
                "en": "nando_label_en"
              },
              "noWrap": false,
              "label": {
                "ja": "疾患",
                "en": "Disease"
              },
              "tooltip": {
                "ja": "NanbyoDataの疾患名。疾患名をクリックすると、NanbyoDataの疾患情報ページへ移動できます。",
                "en": "Disease name in NanbyoData. Clicking the disease name opens the corresponding disease information page in NanbyoData."
              },
              "link": "nando"
            },
            {
              "dataKeyByLocale": {
                "ja": "nando_category",
                "en": "nando_category_en"
              },
              "label": {
                "ja": "制度区分",
                "en": "Medical Subsidy Category"
              },
              "tooltip": {
                "ja": "NanbyoDataが収載する指定難病制度および小児慢性特定疾病制度の区分",
                "en": "Category of the Japanese medical subsidy systems included in NanbyoData, including the Designated Intractable Diseases System (DID System) and the Specific Chronic Pediatric Diseases System (SCPD System)."
              }
            },
            {
              "dataKey": "ncbi_id",
              "label": {
                "ja": "NCBI Gene ID",
                "en": "NCBI Gene ID"
              },
              "tooltip": {
                "ja": "NCBI Geneデータベースにおける遺伝子識別子",
                "en": "Gene identifier assigned by the NCBI Gene database"
              },
              "rowspan": true,
              "rowspanVerticalAlign": "top"
